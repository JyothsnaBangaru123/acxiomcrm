@model PagedResult<ActivityDto>
@{
    ViewData["Title"] = "Activity Log";
    var filter = ViewBag.Filter as ActivityFilterDto ?? new ActivityFilterDto();
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="h4 fw-bold text-dark mb-0">Activity History</h2>
        <p class="text-muted small mb-0">Log of customer calls, meetings, email correspondence, and sales tasks</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-activity me-1"></i> Log Activity
    </a>
</div>

<!-- Search & Filters -->
<div class="crm-card mb-4">
    <div class="crm-card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input type="text" name="SearchTerm" class="form-control" placeholder="Search subject, notes..." value="@filter.SearchTerm" />
                </div>
            </div>
            <div class="col-md-3">
                <select name="Type" class="form-select form-select-sm">
                    <option value="">All Activity Types</option>
                    @foreach (ActivityType t in Enum.GetValues<ActivityType>())
                    {
                        <option value="@t" selected="@(filter.Type == t)">@t</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="Status" class="form-select form-select-sm">
                    <option value="">All Statuses</option>
                    @foreach (ActivityStatus s in Enum.GetValues<ActivityStatus>())
                    {
                        <option value="@s" selected="@(filter.Status == s)">@s</option>
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary flex-grow-1"><i class="bi bi-filter"></i> Apply</button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Activities Table -->
<div class="crm-card">
    <div class="crm-card-body p-0">
        <div class="table-responsive">
            <table class="table crm-table align-middle">
                <thead>
                    <tr>
                        <th>Date & Time</th>
                        <th>Type</th>
                        <th>Subject</th>
                        <th>Related Record</th>
                        <th>Status</th>
                        <th>Logged By</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Any())
                    {
                        @foreach (var act in Model.Items)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold text-dark">@act.ActivityDate.ToString("MMM dd, yyyy")</div>
                                    <small class="text-muted">@act.ActivityDate.ToString("HH:mm") UTC</small>
                                </td>
                                <td>
                                    @switch (act.ActivityType)
                                    {
                                        case ActivityType.Call:
                                            <span class="badge bg-primary-subtle text-primary"><i class="bi bi-telephone"></i> Call</span>
                                            break;
                                        case ActivityType.Meeting:
                                            <span class="badge bg-success-subtle text-success"><i class="bi bi-people"></i> Meeting</span>
                                            break;
                                        case ActivityType.Email:
                                            <span class="badge bg-info-subtle text-info"><i class="bi bi-envelope"></i> Email</span>
                                            break;
                                        case ActivityType.Task:
                                            <span class="badge bg-warning-subtle text-warning"><i class="bi bi-check2-square"></i> Task</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@act.Subject</div>
                                    @if (!string.IsNullOrEmpty(act.Description))
                                    {
                                        <small class="text-muted text-truncate d-block" style="max-width: 320px;">@act.Description</small>
                                    }
                                </td>
                                <td>
                                    @if (act.CustomerId.HasValue)
                                    {
                                        <a asp-controller="Customers" asp-action="Details" asp-route-id="@act.CustomerId" class="fw-semibold text-decoration-none">
                                            @act.CustomerName
                                        </a>
                                        <small class="text-muted d-block">Customer</small>
                                    }
                                    else if (act.LeadId.HasValue)
                                    {
                                        <a asp-controller="Leads" asp-action="Details" asp-route-id="@act.LeadId" class="fw-semibold text-decoration-none">
                                            @act.LeadName
                                        </a>
                                        <small class="text-muted d-block">Lead</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">General</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge @(act.Status == ActivityStatus.Completed ? "bg-success-subtle text-success" : "bg-light text-dark border")">
                                        @act.Status
                                    </span>
                                </td>
                                <td><span class="badge bg-secondary-subtle text-dark">@act.AssignedUserName</span></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-activity fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                <div>No activities found.</div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="crm-card-footer p-3 d-flex justify-content-between align-items-center bg-white border-top">
            <div class="text-muted small">
                Showing @((Model.PageNumber - 1) * Model.PageSize + 1) to @(Math.Min(Model.PageNumber * Model.PageSize, Model.TotalCount)) of @Model.TotalCount records
            </div>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-PageNumber="@(Model.PageNumber - 1)">Previous</a>
                    </li>
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-PageNumber="@i">@i</a>
                        </li>
                    }
                    <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-PageNumber="@(Model.PageNumber + 1)">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
