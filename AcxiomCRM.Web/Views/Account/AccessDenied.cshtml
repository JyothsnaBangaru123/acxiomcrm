@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="crm-card p-5 border-danger">
                <div class="display-1 text-danger mb-3">
                    <i class="bi bi-shield-x"></i>
                </div>
                <h2 class="fw-bold mb-2">Access Denied (403)</h2>
                <p class="text-muted mb-4">
                    You do not have the required role or ownership permissions to access this CRM resource.
                </p>
                <div class="d-flex justify-content-center gap-2">
                    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">
                        <i class="bi bi-arrow-left me-1"></i> Return to Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
