@model UpdateOpportunityDto
@{
    ViewData["Title"] = "Edit Opportunity";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="crm-card">
            <div class="crm-card-header">
                <h2 class="crm-card-title"><i class="bi bi-pencil-square text-primary"></i> Edit Opportunity</h2>
                <a asp-action="Details" asp-route-id="@Model.OpportunityId" class="btn btn-sm btn-outline-secondary">View Details</a>
            </div>
            <div class="crm-card-body">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="OpportunityId" />
                    <input type="hidden" asp-for="LeadId" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="OpportunityName" class="form-label"></label>
                            <input asp-for="OpportunityName" class="form-control" autofocus />
                            <span asp-validation-for="OpportunityName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CustomerId" class="form-label"></label>
                            <select asp-for="CustomerId" asp-items="ViewBag.Customers" class="form-select"></select>
                            <span asp-validation-for="CustomerId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Amount" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="Amount" class="form-control" type="number" step="0.01" />
                            </div>
                            <span asp-validation-for="Amount" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Stage" class="form-label"></label>
                            <select asp-for="Stage" class="form-select">
                                @foreach (OpportunityStage s in Enum.GetValues<OpportunityStage>())
                                {
                                    <option value="@s">@s</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Probability" class="form-label"></label>
                            <div class="input-group">
                                <input asp-for="Probability" class="form-control" type="number" min="0" max="100" />
                                <span class="input-group-text">%</span>
                            </div>
                            <span asp-validation-for="Probability" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ExpectedCloseDate" class="form-label"></label>
                            <input asp-for="ExpectedCloseDate" class="form-control" type="date" />
                            <span asp-validation-for="ExpectedCloseDate" class="text-danger small"></span>
                        </div>

                        @if (ViewBag.AssignedUsers != null)
                        {
                            <div class="col-md-6">
                                <label asp-for="AssignedTo" class="form-label"></label>
                                <select asp-for="AssignedTo" asp-items="ViewBag.AssignedUsers" class="form-select">
                                    <option value="">-- Assign Sales Executive --</option>
                                </select>
                            </div>
                        }

                        <div class="col-12">
                            <label asp-for="Notes" class="form-label"></label>
                            <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Notes" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-1"></i> Update Opportunity</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
