@model PagedResult<LeadDto>
@{
    ViewData["Title"] = "Lead Management";
    var filter = ViewBag.Filter as LeadFilterDto ?? new LeadFilterDto();
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="h4 fw-bold text-dark mb-0">Lead Pipeline</h2>
        <p class="text-muted small mb-0">Track prospect discovery, qualification, and customer conversion</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-funnel-fill me-1"></i> Capture New Lead
    </a>
</div>

<!-- Search & Filters -->
<div class="crm-card mb-4">
    <div class="crm-card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-3">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input type="text" name="SearchTerm" class="form-control" placeholder="Search by name, company, email..." value="@filter.SearchTerm" />
                </div>
            </div>
            <div class="col-md-2">
                <select name="Status" class="form-select form-select-sm">
                    <option value="">All Statuses</option>
                    @foreach (LeadStatus s in Enum.GetValues<LeadStatus>())
                    {
                        <option value="@s" selected="@(filter.Status == s)">@s</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="Source" class="form-select form-select-sm">
                    <option value="">All Sources</option>
                    @foreach (LeadSource s in Enum.GetValues<LeadSource>())
                    {
                        <option value="@s" selected="@(filter.Source == s)">@s</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="Priority" class="form-select form-select-sm">
                    <option value="">All Priorities</option>
                    @foreach (LeadPriority p in Enum.GetValues<LeadPriority>())
                    {
                        <option value="@p" selected="@(filter.Priority == p)">@p</option>
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary flex-grow-1"><i class="bi bi-filter"></i> Apply</button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Leads Table -->
<div class="crm-card">
    <div class="crm-card-body p-0">
        <div class="table-responsive">
            <table class="table crm-table align-middle">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Lead Name</th>
                        <th>Company</th>
                        <th>Source</th>
                        <th>Status</th>
                        <th>Priority</th>
                        <th>Expected Value</th>
                        <th>Assigned To</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Any())
                    {
                        @foreach (var lead in Model.Items)
                        {
                            <tr>
                                <td><span class="badge bg-light text-dark border">@lead.LeadCode</span></td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@lead.LeadId" class="fw-bold text-decoration-none text-dark">
                                        @lead.LeadName
                                    </a>
                                    <div class="small text-muted">@lead.Email</div>
                                </td>
                                <td>@(lead.CompanyName ?? "—")</td>
                                <td><span class="badge bg-light text-dark border">@lead.Source</span></td>
                                <td>
                                    @switch (lead.Status)
                                    {
                                        case LeadStatus.New:
                                            <span class="badge-status badge-status-new"><i class="bi bi-star"></i> New</span>
                                            break;
                                        case LeadStatus.Contacted:
                                            <span class="badge-status badge-status-contacted"><i class="bi bi-telephone"></i> Contacted</span>
                                            break;
                                        case LeadStatus.Qualified:
                                            <span class="badge-status badge-status-qualified"><i class="bi bi-check2"></i> Qualified</span>
                                            break;
                                        case LeadStatus.Converted:
                                            <span class="badge-status badge-status-converted"><i class="bi bi-arrow-repeat"></i> Converted</span>
                                            break;
                                        case LeadStatus.Lost:
                                            <span class="badge-status badge-status-lost"><i class="bi bi-x-circle"></i> Lost</span>
                                            break;
                                        default:
                                            <span class="badge-status badge-status-unqualified">@lead.Status</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    <span class="badge @(lead.Priority == LeadPriority.Urgent ? "bg-danger" : lead.Priority == LeadPriority.High ? "bg-warning text-dark" : "bg-light text-dark border")">
                                        @lead.Priority
                                    </span>
                                </td>
                                <td class="fw-bold text-success">$@lead.ExpectedValue.ToString("N0")</td>
                                <td><span class="badge bg-secondary-subtle text-dark">@lead.AssignedUserName</span></td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@lead.LeadId" class="btn btn-outline-secondary" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        @if (lead.Status != LeadStatus.Converted)
                                        {
                                            <a asp-action="Convert" asp-route-id="@lead.LeadId" class="btn btn-outline-success" title="Convert to Customer">
                                                <i class="bi bi-arrow-repeat"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@lead.LeadId" class="btn btn-outline-primary" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <form asp-action="Delete" asp-route-id="@lead.LeadId" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-danger" title="Mark as Lost" data-confirm="Are you sure you want to mark lead '@lead.LeadName' as Lost?">
                                                    <i class="bi bi-x-lg"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="bi bi-funnel fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                <div>No leads found matching your criteria.</div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="crm-card-footer p-3 d-flex justify-content-between align-items-center bg-white border-top">
            <div class="text-muted small">
                Showing @((Model.PageNumber - 1) * Model.PageSize + 1) to @(Math.Min(Model.PageNumber * Model.PageSize, Model.TotalCount)) of @Model.TotalCount leads
            </div>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-PageNumber="@(Model.PageNumber - 1)" asp-route-SearchTerm="@filter.SearchTerm" asp-route-Status="@filter.Status" asp-route-Source="@filter.Source" asp-route-Priority="@filter.Priority">Previous</a>
                    </li>
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-PageNumber="@i" asp-route-SearchTerm="@filter.SearchTerm" asp-route-Status="@filter.Status" asp-route-Source="@filter.Source" asp-route-Priority="@filter.Priority">@i</a>
                        </li>
                    }
                    <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-PageNumber="@(Model.PageNumber + 1)" asp-route-SearchTerm="@filter.SearchTerm" asp-route-Status="@filter.Status" asp-route-Source="@filter.Source" asp-route-Priority="@filter.Priority">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
