@model LeadDetailDto
@{
    ViewData["Title"] = $"{Model.LeadName} - Lead Details";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <h2 class="h4 fw-bold text-dark mb-0">@Model.LeadName</h2>
            <span class="badge bg-light text-dark border">@Model.LeadCode</span>
            <span class="badge @(Model.Priority == LeadPriority.Urgent ? "bg-danger" : Model.Priority == LeadPriority.High ? "bg-warning text-dark" : "bg-light text-dark border")">
                @Model.Priority Priority
            </span>
        </div>
        <p class="text-muted small mb-0">@(Model.CompanyName ?? "Prospect") &bull; Source: <strong>@Model.Source</strong> &bull; Assigned to: <strong>@Model.AssignedUserName</strong></p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        @if (Model.Status != LeadStatus.Converted)
        {
            <a asp-action="Convert" asp-route-id="@Model.LeadId" class="btn btn-success btn-sm">
                <i class="bi bi-arrow-repeat me-1"></i> Convert to Customer
            </a>
            <a asp-action="Edit" asp-route-id="@Model.LeadId" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-pencil me-1"></i> Edit Lead
            </a>
            <a asp-controller="FollowUps" asp-action="Create" asp-route-leadId="@Model.LeadId" class="btn btn-warning btn-sm text-dark">
                <i class="bi bi-calendar-plus me-1"></i> Schedule Follow-Up
            </a>
            <a asp-controller="Activities" asp-action="Create" asp-route-leadId="@Model.LeadId" class="btn btn-secondary btn-sm">
                <i class="bi bi-activity me-1"></i> Log Activity
            </a>
        }
        else
        {
            <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.ConvertedCustomerId" class="btn btn-primary btn-sm">
                <i class="bi bi-person-check me-1"></i> View Converted Customer
            </a>
        }
    </div>
</div>

<!-- Status Progression Stepper -->
<div class="crm-card mb-4">
    <div class="crm-card-body py-3">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
            <span class="text-muted small fw-bold">LEAD WORKFLOW:</span>
            <div class="d-flex flex-wrap align-items-center gap-1">
                @foreach (LeadStatus s in Enum.GetValues<LeadStatus>())
                {
                    var isCurrent = Model.Status == s;
                    <form asp-action="UpdateStatus" asp-route-id="@Model.LeadId" asp-route-newStatus="@s" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm @(isCurrent ? "btn-primary fw-bold" : "btn-outline-secondary")" @(Model.Status == LeadStatus.Converted ? "disabled" : "")>
                            @if (isCurrent) { <i class="bi bi-check-circle-fill me-1"></i> }
                            @s
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Left Column: Lead Info -->
    <div class="col-lg-4">
        <div class="crm-card">
            <div class="crm-card-header">
                <h3 class="crm-card-title"><i class="bi bi-info-circle-fill text-primary"></i> Lead Profile</h3>
            </div>
            <div class="crm-card-body">
                <ul class="list-unstyled mb-0">
                    <li class="mb-3">
                        <div class="text-muted small">Email</div>
                        <div class="fw-semibold"><a href="mailto:@Model.Email" class="text-decoration-none">@Model.Email</a></div>
                    </li>
                    <li class="mb-3">
                        <div class="text-muted small">Phone</div>
                        <div class="fw-semibold">@Model.Phone</div>
                    </li>
                    <li class="mb-3">
                        <div class="text-muted small">Company</div>
                        <div class="fw-semibold">@(Model.CompanyName ?? "—")</div>
                    </li>
                    <li class="mb-3">
                        <div class="text-muted small">Expected Value</div>
                        <div class="fw-bold fs-5 text-success">$@Model.ExpectedValue.ToString("N0")</div>
                    </li>
                    <li class="mb-3">
                        <div class="text-muted small">Assigned Sales Executive</div>
                        <div class="fw-semibold text-primary">@Model.AssignedUserName</div>
                    </li>
                    <li class="mb-3">
                        <div class="text-muted small">Captured On</div>
                        <div class="small">@Model.CreatedDate.ToString("MMMM dd, yyyy")</div>
                    </li>
                    @if (!string.IsNullOrWhiteSpace(Model.Notes))
                    {
                        <li>
                            <div class="text-muted small">Notes</div>
                            <div class="p-2 bg-light rounded small mt-1">@Model.Notes</div>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <!-- Right Column: Related Deals, Follow-ups, Activities -->
    <div class="col-lg-8">
        <!-- Follow-Ups -->
        <div class="crm-card mb-4">
            <div class="crm-card-header">
                <h3 class="crm-card-title"><i class="bi bi-calendar-event-fill text-warning"></i> Follow-Ups (@Model.FollowUps.Count)</h3>
                <a asp-controller="FollowUps" asp-action="Create" asp-route-leadId="@Model.LeadId" class="btn btn-sm btn-link text-decoration-none">+ Schedule</a>
            </div>
            <div class="crm-card-body p-0">
                @if (Model.FollowUps.Any())
                {
                    <div class="table-responsive">
                        <table class="table crm-table align-middle">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Type</th>
                                    <th>Status</th>
                                    <th>Remarks</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var fu in Model.FollowUps)
                                {
                                    <tr>
                                        <td class="fw-bold">@fu.FollowUpDate.ToString("MMM dd, yyyy")</td>
                                        <td><span class="badge bg-light text-dark border">@fu.FollowUpType</span></td>
                                        <td><span class="badge bg-info-subtle text-dark">@fu.Status</span></td>
                                        <td>@fu.Remarks</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-3 text-center text-muted small">No follow-ups recorded for this lead.</div>
                }
            </div>
        </div>

        <!-- Activity History -->
        <div class="crm-card">
            <div class="crm-card-header">
                <h3 class="crm-card-title"><i class="bi bi-activity text-secondary"></i> Activity Log (@Model.Activities.Count)</h3>
                <a asp-controller="Activities" asp-action="Create" asp-route-leadId="@Model.LeadId" class="btn btn-sm btn-link text-decoration-none">+ Log</a>
            </div>
            <div class="crm-card-body p-0">
                @if (Model.Activities.Any())
                {
                    <div class="table-responsive">
                        <table class="table crm-table align-middle">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Type</th>
                                    <th>Subject</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var act in Model.Activities)
                                {
                                    <tr>
                                        <td>@act.ActivityDate.ToString("MMM dd, yyyy HH:mm")</td>
                                        <td><span class="badge bg-secondary-subtle text-dark">@act.ActivityType</span></td>
                                        <td class="fw-semibold">@act.Subject</td>
                                        <td><span class="badge bg-success-subtle text-success">@act.Status</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-3 text-center text-muted small">No activities logged yet.</div>
                }
            </div>
        </div>
    </div>
</div>
