@model ConvertLeadDto
@{
    ViewData["Title"] = "Convert Lead to Customer";
    var lead = ViewBag.Lead as LeadDto;
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="crm-card">
            <div class="crm-card-header bg-success-subtle">
                <h2 class="crm-card-title text-success"><i class="bi bi-arrow-repeat"></i> Convert Lead to Customer</h2>
                <a asp-action="Details" asp-route-id="@Model.LeadId" class="btn btn-sm btn-outline-secondary">Cancel</a>
            </div>
            <div class="crm-card-body">
                @if (lead != null)
                {
                    <div class="alert alert-info py-2 d-flex align-items-center gap-2 mb-4">
                        <i class="bi bi-info-circle-fill fs-5"></i>
                        <div>
                            Converting <strong>@lead.LeadName</strong> (@lead.Email) from <em>@lead.CompanyName</em> into an active Customer account.
                        </div>
                    </div>
                }

                <form asp-action="Convert" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="LeadId" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <!-- Opportunity Generation Options -->
                    <div class="p-3 bg-light rounded-3 border mb-4">
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" asp-for="CreateOpportunity" id="toggleOpp" checked />
                            <label class="form-check-label fw-bold" for="toggleOpp">
                                Simultaneously create an active Sales Opportunity
                            </label>
                        </div>

                        <div id="oppFields" class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="OpportunityName" class="form-label"></label>
                                <input asp-for="OpportunityName" class="form-control" />
                                <span asp-validation-for="OpportunityName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="OpportunityAmount" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="OpportunityAmount" class="form-control" type="number" step="100" />
                                </div>
                                <span asp-validation-for="OpportunityAmount" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="OpportunityStage" class="form-label"></label>
                                <select asp-for="OpportunityStage" class="form-select">
                                    @foreach (OpportunityStage s in Enum.GetValues<OpportunityStage>())
                                    {
                                        <option value="@s">@s</option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Probability" class="form-label"></label>
                                <div class="input-group">
                                    <input asp-for="Probability" class="form-control" type="number" min="0" max="100" />
                                    <span class="input-group-text">%</span>
                                </div>
                                <span asp-validation-for="Probability" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="ExpectedCloseDate" class="form-label"></label>
                                <input asp-for="ExpectedCloseDate" class="form-control" type="date" value="@DateTime.UtcNow.AddDays(30).ToString("yyyy-MM-dd")" />
                                <span asp-validation-for="ExpectedCloseDate" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Details" asp-route-id="@Model.LeadId" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-success"><i class="bi bi-check2-circle me-1"></i> Confirm & Convert</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const toggle = document.getElementById('toggleOpp');
        const fields = document.getElementById('oppFields');
        if (toggle && fields) {
            toggle.addEventListener('change', () => {
                fields.style.display = toggle.checked ? 'flex' : 'none';
            });
        }
    </script>
}
