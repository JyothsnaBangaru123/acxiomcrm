@model ConversionRateReportDto
@{
    ViewData["Title"] = "Lead Conversion Report";
    var start = ViewBag.StartDate as DateTime?;
    var end = ViewBag.EndDate as DateTime?;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="h4 fw-bold text-dark mb-0">Lead Conversion & Outcome Report</h2>
        <p class="text-muted small mb-0">Analysis of lead capture volume, qualification thresholds, and customer conversion rates</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to Reports</a>
</div>

<!-- Date Filter Form -->
<div class="crm-card mb-4">
    <div class="crm-card-body p-3">
        <form method="get" asp-action="Conversion" class="row g-2 align-items-center">
            <div class="col-md-4">
                <label class="form-label small text-muted mb-1">From Date</label>
                <input type="date" name="start" class="form-control form-control-sm" value="@start?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-4">
                <label class="form-label small text-muted mb-1">To Date</label>
                <input type="date" name="end" class="form-control form-control-sm" value="@end?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-4 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-sm btn-primary flex-grow-1"><i class="bi bi-filter"></i> Filter</button>
                <a asp-action="Conversion" class="btn btn-sm btn-outline-secondary">Clear</a>
            </div>
        </form>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-6 col-lg-3">
        <div class="kpi-card kpi-primary">
            <div class="kpi-title">Total Leads Captured</div>
            <div class="kpi-value text-primary">@Model.TotalLeads</div>
            <div class="kpi-subtext">All channels & sources</div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="kpi-card kpi-info">
            <div class="kpi-title">Qualified Leads</div>
            <div class="kpi-value text-info">@Model.QualifiedLeads</div>
            <div class="kpi-subtext">Rate: @Model.QualificationRate%</div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="kpi-card kpi-success">
            <div class="kpi-title">Converted Customers</div>
            <div class="kpi-value text-success">@Model.ConvertedLeads</div>
            <div class="kpi-subtext">Conversion Rate: @Model.ConversionRate%</div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="kpi-card kpi-danger">
            <div class="kpi-title">Lost / Unqualified</div>
            <div class="kpi-value text-danger">@Model.LostLeads</div>
            <div class="kpi-subtext">Closed without conversion</div>
        </div>
    </div>
</div>
