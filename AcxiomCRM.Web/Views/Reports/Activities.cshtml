@model IReadOnlyList<UserActivityReportItemDto>
@{
    ViewData["Title"] = "User Activity Report";
    var start = ViewBag.StartDate as DateTime?;
    var end = ViewBag.EndDate as DateTime?;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="h4 fw-bold text-dark mb-0">Sales Representative Activity Report</h2>
        <p class="text-muted small mb-0">Track individual sales activities, calls, meetings, emails, and follow-up completions</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to Reports</a>
</div>

<!-- Date Filter Form -->
<div class="crm-card mb-4">
    <div class="crm-card-body p-3">
        <form method="get" asp-action="Activities" class="row g-2 align-items-center">
            <div class="col-md-4">
                <label class="form-label small text-muted mb-1">From Date</label>
                <input type="date" name="start" class="form-control form-control-sm" value="@start?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-4">
                <label class="form-label small text-muted mb-1">To Date</label>
                <input type="date" name="end" class="form-control form-control-sm" value="@end?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-4 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-sm btn-primary flex-grow-1"><i class="bi bi-filter"></i> Filter</button>
                <a asp-action="Activities" class="btn btn-sm btn-outline-secondary">Clear</a>
            </div>
        </form>
    </div>
</div>

<div class="crm-card">
    <div class="crm-card-body p-0">
        <div class="table-responsive">
            <table class="table crm-table align-middle">
                <thead>
                    <tr>
                        <th>User Name</th>
                        <th>Role</th>
                        <th>Calls</th>
                        <th>Meetings</th>
                        <th>Emails</th>
                        <th>Tasks</th>
                        <th>Completed Follow-Ups</th>
                        <th>Pending Follow-Ups</th>
                        <th>Total Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var u in Model)
                        {
                            <tr>
                                <td class="fw-bold text-dark">
                                    <i class="bi bi-person-circle me-1 text-muted"></i> @u.UserName
                                </td>
                                <td><span class="badge bg-light text-dark border">@u.Role</span></td>
                                <td>@u.TotalCalls</td>
                                <td>@u.TotalMeetings</td>
                                <td>@u.TotalEmails</td>
                                <td>@u.TotalTasks</td>
                                <td><span class="badge bg-success-subtle text-success">@u.CompletedFollowUps</span></td>
                                <td><span class="badge bg-warning-subtle text-warning">@u.PendingFollowUps</span></td>
                                <td class="fw-bold text-primary">@u.TotalActivitiesCount</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">No activity data found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
