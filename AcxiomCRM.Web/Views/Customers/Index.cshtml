@model PagedResult<CustomerDto>
@{
    ViewData["Title"] = "Customer Management";
    var filter = ViewBag.Filter as CustomerFilterDto ?? new CustomerFilterDto();
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="h4 fw-bold text-dark mb-0">Customer Directory</h2>
        <p class="text-muted small mb-0">Manage customer accounts, relationships, and deal history</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-person-plus me-1"></i> Add Customer
    </a>
</div>

<!-- Filter Bar -->
<div class="crm-card mb-4">
    <div class="crm-card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input type="text" name="SearchTerm" class="form-control" placeholder="Search by name, email, phone, company..." value="@filter.SearchTerm" />
                </div>
            </div>
            <div class="col-md-3">
                <input type="text" name="City" class="form-control form-control-sm" placeholder="Filter by City..." value="@filter.City" />
            </div>
            <div class="col-md-2">
                <select name="Status" class="form-select form-select-sm">
                    <option value="">All Statuses</option>
                    <option value="Active" selected="@(filter.Status == CustomerStatus.Active)">Active</option>
                    <option value="Inactive" selected="@(filter.Status == CustomerStatus.Inactive)">Inactive</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary flex-grow-1"><i class="bi bi-filter"></i> Apply</button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Customers Table -->
<div class="crm-card">
    <div class="crm-card-body p-0">
        <div class="table-responsive">
            <table class="table crm-table align-middle">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Customer Name</th>
                        <th>Company</th>
                        <th>Contact</th>
                        <th>Owner</th>
                        <th>Pipeline ($)</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Any())
                    {
                        @foreach (var c in Model.Items)
                        {
                            <tr>
                                <td><span class="badge bg-light text-dark border">@c.CustomerCode</span></td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@c.CustomerId" class="fw-bold text-decoration-none text-dark">
                                        @c.CustomerName
                                    </a>
                                </td>
                                <td>@(c.CompanyName ?? "—")</td>
                                <td>
                                    <div><i class="bi bi-envelope text-muted me-1 small"></i> @c.Email</div>
                                    <div><i class="bi bi-telephone text-muted me-1 small"></i> @c.Phone</div>
                                </td>
                                <td><span class="badge bg-secondary-subtle text-dark">@c.OwnerName</span></td>
                                <td class="fw-bold text-success">$@c.TotalPipelineAmount.ToString("N0")</td>
                                <td>
                                    @if (c.Status == CustomerStatus.Active)
                                    {
                                        <span class="badge-status badge-status-active"><i class="bi bi-check-circle-fill"></i> Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge-status badge-status-inactive"><i class="bi bi-slash-circle"></i> Inactive</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@c.CustomerId" class="btn btn-outline-secondary" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@c.CustomerId" class="btn btn-outline-primary" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@c.CustomerId" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger" title="Deactivate" data-confirm="Are you sure you want to deactivate customer '@c.CustomerName'?">
                                                <i class="bi bi-power"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-people fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                <div>No customers found matching your criteria.</div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="crm-card-footer p-3 d-flex justify-content-between align-items-center bg-white border-top">
            <div class="text-muted small">
                Showing @((Model.PageNumber - 1) * Model.PageSize + 1) to @(Math.Min(Model.PageNumber * Model.PageSize, Model.TotalCount)) of @Model.TotalCount customers
            </div>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-PageNumber="@(Model.PageNumber - 1)" asp-route-SearchTerm="@filter.SearchTerm" asp-route-City="@filter.City" asp-route-Status="@filter.Status">Previous</a>
                    </li>
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-PageNumber="@i" asp-route-SearchTerm="@filter.SearchTerm" asp-route-City="@filter.City" asp-route-Status="@filter.Status">@i</a>
                        </li>
                    }
                    <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-PageNumber="@(Model.PageNumber + 1)" asp-route-SearchTerm="@filter.SearchTerm" asp-route-City="@filter.City" asp-route-Status="@filter.Status">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
