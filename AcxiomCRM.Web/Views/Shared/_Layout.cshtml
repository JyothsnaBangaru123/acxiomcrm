@using Microsoft.AspNetCore.Identity
@using AcxiomCRM.Domain.Entities
@using AcxiomCRM.Domain.Enums
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    var isAuthenticated = SignInManager.IsSignedIn(User);
    var currentUser = isAuthenticated ? await UserManager.GetUserAsync(User) : null;
    var currentRole = isAuthenticated && currentUser != null ? (await UserManager.GetRolesAsync(currentUser)).FirstOrDefault() ?? "SalesExecutive" : "";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AcxiomCRM Enterprise</title>
    
    <!-- Bootstrap 5.3 & Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    
    <!-- Custom Theme -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (isAuthenticated)
    {
        <div class="app-wrapper">
            <!-- Sidebar Navigation -->
            <aside class="app-sidebar">
                <div class="sidebar-header">
                    <div class="sidebar-logo">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <div>
                        <div class="sidebar-brand-name">AcxiomCRM</div>
                        <span class="sidebar-brand-badge">@currentRole</span>
                    </div>
                </div>

                <ul class="sidebar-menu">
                    <li class="sidebar-heading">Core</li>
                    <li class="sidebar-item">
                        <a class="sidebar-link @(currentController == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index">
                            <i class="bi bi-speedometer2"></i>
                            <span>Dashboard</span>
                        </a>
                    </li>

                    <li class="sidebar-heading">CRM Lifecycle</li>
                    <li class="sidebar-item">
                        <a class="sidebar-link @(currentController == "Customers" ? "active" : "")" asp-controller="Customers" asp-action="Index">
                            <i class="bi bi-people-fill"></i>
                            <span>@(currentRole == AppRoles.SalesExecutive ? "My Customers" : "Customers")</span>
                        </a>
                    </li>
                    <li class="sidebar-item">
                        <a class="sidebar-link @(currentController == "Leads" ? "active" : "")" asp-controller="Leads" asp-action="Index">
                            <i class="bi bi-funnel-fill"></i>
                            <span>@(currentRole == AppRoles.SalesExecutive ? "My Leads" : "Leads")</span>
                        </a>
                    </li>
                    <li class="sidebar-item">
                        <a class="sidebar-link @(currentController == "Opportunities" ? "active" : "")" asp-controller="Opportunities" asp-action="Index">
                            <i class="bi bi-briefcase-fill"></i>
                            <span>@(currentRole == AppRoles.SalesExecutive ? "My Opportunities" : "Opportunities")</span>
                        </a>
                    </li>
                    <li class="sidebar-item">
                        <a class="sidebar-link @(currentController == "FollowUps" ? "active" : "")" asp-controller="FollowUps" asp-action="Index">
                            <i class="bi bi-calendar-check-fill"></i>
                            <span>@(currentRole == AppRoles.SalesExecutive ? "My Follow-Ups" : "Follow-Ups")</span>
                        </a>
                    </li>
                    <li class="sidebar-item">
                        <a class="sidebar-link @(currentController == "Activities" ? "active" : "")" asp-controller="Activities" asp-action="Index">
                            <i class="bi bi-activity"></i>
                            <span>@(currentRole == AppRoles.SalesExecutive ? "My Activities" : "Activities")</span>
                        </a>
                    </li>

                    <li class="sidebar-heading">Analytics</li>
                    <li class="sidebar-item">
                        <a class="sidebar-link @(currentController == "Reports" ? "active" : "")" asp-controller="Reports" asp-action="Index">
                            <i class="bi bi-bar-chart-fill"></i>
                            <span>Reports</span>
                        </a>
                    </li>

                    @if (currentRole == AppRoles.Admin || currentRole == AppRoles.Manager)
                    {
                        <li class="sidebar-heading">Administration</li>
                        @if (currentRole == AppRoles.Admin)
                        {
                            <li class="sidebar-item">
                                <a class="sidebar-link @(currentController == "Users" ? "active" : "")" asp-controller="Users" asp-action="Index">
                                    <i class="bi bi-person-gear"></i>
                                    <span>Users & Roles</span>
                                </a>
                            </li>
                        }
                        <li class="sidebar-item">
                            <a class="sidebar-link @(currentController == "AuditLogs" ? "active" : "")" asp-controller="AuditLogs" asp-action="Index">
                                <i class="bi bi-journal-text"></i>
                                <span>Audit Logs</span>
                            </a>
                        </li>
                    }

                    <li class="sidebar-heading">Developer API</li>
                    <li class="sidebar-item">
                        <a class="sidebar-link" href="/swagger" target="_blank">
                            <i class="bi bi-code-slash"></i>
                            <span>Swagger REST API</span>
                        </a>
                    </li>
                </ul>

                <div class="sidebar-footer">
                    <div class="d-flex align-items-center justify-content-between text-white-50 small">
                        <div>AcxiomCRM v1.0.0</div>
                        <i class="bi bi-patch-check-fill text-success" title="System Healthy"></i>
                    </div>
                </div>
            </aside>

            <!-- Main Workspace -->
            <div class="app-main">
                <!-- Topbar -->
                <header class="app-topbar">
                    <div class="d-flex align-items-center gap-3">
                        <button class="btn btn-sm btn-outline-secondary d-lg-none" id="sidebarToggle" type="button">
                            <i class="bi bi-list"></i>
                        </button>
                        <h1 class="topbar-title">@ViewData["Title"]</h1>
                    </div>

                    <div class="topbar-actions">
                        <div class="dropdown">
                            <button class="btn btn-link text-decoration-none dropdown-toggle p-0 d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <div class="user-avatar">
                                    @(currentUser?.FullName?.Substring(0, 1).ToUpper() ?? "U")
                                </div>
                                <div class="text-start d-none d-sm-block">
                                    <div class="fw-semibold text-dark small" style="line-height: 1.2;">@(currentUser?.FullName ?? "User")</div>
                                    <div class="text-muted" style="font-size: 0.72rem;">@currentRole</div>
                                </div>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                <li class="px-3 py-2 border-bottom">
                                    <div class="fw-bold small">@(currentUser?.FullName)</div>
                                    <div class="text-muted small">@(currentUser?.Email)</div>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Account" asp-action="ChangePassword">
                                        <i class="bi bi-key me-2 text-primary"></i> Change Password
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item py-2 text-danger">
                                            <i class="bi bi-box-arrow-right me-2"></i> Sign Out
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>
                </header>

                <!-- Notifications -->
                <div class="px-4 pt-3">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show shadow-sm d-flex align-items-center gap-2" role="alert">
                            <i class="bi bi-check-circle-fill fs-5"></i>
                            <div>@TempData["SuccessMessage"]</div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show shadow-sm d-flex align-items-center gap-2" role="alert">
                            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                            <div>@TempData["ErrorMessage"]</div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @if (TempData["WarningMessage"] != null)
                    {
                        <div class="alert alert-warning alert-dismissible fade show shadow-sm d-flex align-items-center gap-2" role="alert">
                            <i class="bi bi-exclamation-circle-fill fs-5"></i>
                            <div>@TempData["WarningMessage"]</div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                </div>

                <!-- Page Body -->
                <main class="app-content">
                    @RenderBody()
                </main>

                <footer class="py-3 px-4 bg-white border-top text-center text-muted small mt-auto">
                    <div>AcxiomCRM Enterprise Platform &copy; @DateTime.UtcNow.Year — Secure Role-Based Customer Relationship Management</div>
                </footer>
            </div>
        </div>
    }
    else
    {
        <!-- Anonymous / Auth Pages Layout -->
        <main>
            @RenderBody()
        </main>
    }

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
